# Application
APP_NAME=Negotia API
API_VERSION=0.1.0
DEBUG=false

# Database
DATABASE_URL=postgresql+psycopg://negotia:local-development-password@localhost:5432/negotia
POSTGRES_DB=negotia
POSTGRES_USER=negotia
POSTGRES_PASSWORD=local-development-password
POSTGRES_PORT=5432

# Docker Compose API host port
API_PORT=8000

# Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_LOCAL_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM provider
LLM_PROVIDER=fake
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# AWS session
AWS_REGION=us-east-1
AWS_PROFILE=
