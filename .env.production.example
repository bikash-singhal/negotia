# Application
APP_NAME="Negotia API"
API_VERSION=0.1.0
DEBUG=false
API_PORT=8000

# Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL
POSTGRES_DB=negotia
POSTGRES_USER=negotia
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD

# Important:
# Use a URL-encoded password inside DATABASE_URL.
# Example: @ becomes %40, : becomes %3A, / becomes %2F
DATABASE_URL=postgresql+psycopg://negotia:CHANGE_ME_TO_URL_ENCODED_PASSWORD@database:5432/negotia

# AWS Bedrock
# Credentials come from the EC2 IAM role.
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-1
